# `pnpm --filter agent setup` writes a real .env and apps/web/.env.local for you.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
VAULT_ACCOUNT_ID=
OWNER_ACCOUNT_ID=
MERCHANT_ACCOUNT_ID=
ATTACKER_ACCOUNT_ID=
# ed25519 function-call key. It can only call agent_spend on the vault.
AGENT_PRIVATE_KEY=
MERCHANT_URL=http://localhost:8788/report
# From cloud.near.ai. Without it, tasks are off and the injection scenario runs without a model.
NEAR_AI_KEY=
# Must be a model the model list marks as verifiable and tool-capable.
NEAR_AI_MODEL=z-ai/glm-5.3-flash
