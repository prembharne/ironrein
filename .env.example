# `pnpm --filter agent run bootstrap` writes a real .env and apps/web/.env.local for you.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
VAULT_ACCOUNT_ID=
OWNER_ACCOUNT_ID=
MERCHANT_ACCOUNT_ID=
ATTACKER_ACCOUNT_ID=
# ed25519 function-call key. It can only call agent_spend on the vault.
AGENT_PRIVATE_KEY=
MERCHANT_URL=http://localhost:8788/report
# From cloud.near.ai. Without it, tasks are off and the injection scenario runs without a model.
NEAR_AI_KEY=
# Must be a model the model list marks as verifiable and tool-capable.
NEAR_AI_MODEL=z-ai/glm-5.3-flash
# Optional. Merchant shows what its NEAR payment becomes on another chain, using a live
# NEAR Intents (1Click) quote. Both must be set. Asset ids come from
# https://1click.chaindefuser.com/v0/tokens. Quote only: no funds move.
# USDC on Base: nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
SETTLE_ASSET_ID=
# The merchant's own address on that chain.
SETTLE_RECIPIENT=
# Optional sealed signer mode: the agent key lives in an OutLayer TEE instead of this file.
# Steps are in enclave/README.md. When OUTLAYER_PROJECT is set, AGENT_PRIVATE_KEY is not used.
OUTLAYER_PROJECT=
OUTLAYER_PAYMENT_KEY=
OUTLAYER_SECRETS_ACCOUNT=
# Printed by `pnpm --filter agent run sealed-key`.
AGENT_PUBLIC_KEY=
# Comma-separated web origins allowed to call the agent service. Add your hosted site here.
WEB_ORIGIN=http://localhost:3000
